FROM node:22-alpine AS builder
WORKDIR /app

# Salin hanya package.json (tanpa package-lock.json)
COPY package.json ./

# Install dependencies
RUN npm install --legacy-peer-deps

# Salin sisa source code
COPY . .

# Buang lockfile rusak yang ikut tersalin, lalu pastikan next & swc sinkron
RUN rm -f package-lock.json && \
    npm ls next @next/swc-linux-x64-musl --legacy-peer-deps || true

# Matikan telemetry (opsional) dan build
ENV NEXT_TELEMETRY_DISABLED=1
RUN npx next build


FROM node:22-alpine AS runner
WORKDIR /app

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

COPY --from=builder /app/package.json ./
COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs

EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

CMD ["node", "server.js"]
